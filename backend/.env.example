# =======================================================
# VoxCore AI Voice Assistant - LLM Model Configuration
# =======================================================

# Option 1: Groq (Recommended - 100% Free & Blazing Fast for Real-Time Voice)
# Get your free key instantly at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: OpenAI (GPT-4o-mini / GPT-4o)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option 3: Google Gemini (Gemini 1.5 / 2.0 Flash)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 4: Local Ollama (100% Offline & Free, No API key needed)
# Download from https://ollama.ai and run: ollama run llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Active Provider: "auto" (detects available key) or "groq" | "openai" | "gemini" | "ollama"
LLM_PROVIDER=auto

